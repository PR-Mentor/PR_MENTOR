# Optional GitHub Personal Access Token to raise GitHub API rate limits.
GITHUB_TOKEN=

# Named AI providers. Keep real API keys in Render or another secret store,
# never in this file.
GEMINI_API_KEY=
DEEPSEEK_API=
GROQ_API=
NVIDIA_API=

# Default order when the provider keys above are configured:
# Gemini -> DeepSeek -> Groq -> NVIDIA.
# Optional override for the selected provider:
# LLM_PROVIDER=gemini
# Optional comma-separated fallback order:
# LLM_FALLBACK_PROVIDERS=deepseek,groq,nvidia

# Optional task-specific routing. Task suffixes currently supported:
# CODE_REVIEW, FIX_GENERATION, TEST_GENERATION, ISSUE_EXPLANATION,
# SEMANTIC_REVIEW.
# LLM_PROVIDER_CODE_REVIEW=gemini
# LLM_FALLBACK_PROVIDERS_CODE_REVIEW=deepseek,groq,nvidia
#
# Optional named-provider model/endpoint overrides:
# LLM_GEMINI_MODEL=gemini-3.8-flash
# LLM_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_DEEPSEEK_MODEL=deepseek-flash
# LLM_DEEPSEEK_API_BASE_URL=https://api.deepseek.com/chat/completions
# LLM_GROQ_MODEL=openai/gpt-oss-20b
# LLM_GROQ_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_NVIDIA_MODEL=openai/gpt-oss-20b
# LLM_NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
#
# Optional generic OpenAI-compatible provider for backward compatibility:
# LLM_API_KEY=
# LLM_MODEL=
# LLM_API_BASE_URL=
#
# Retry and concurrency controls:
LLM_PROVIDER_RETRIES=1
LLM_PROVIDER_RATE_LIMIT_RETRIES=3
LLM_GEMINI_MAX_CONCURRENCY=2
LLM_DEEPSEEK_MAX_CONCURRENCY=2
LLM_GROQ_MAX_CONCURRENCY=2
LLM_NVIDIA_MAX_CONCURRENCY=2

# Select sqlite (default) or mongodb. MongoDB failures never fall back to SQLite.
PR_MENTOR_STORAGE=sqlite

# Required when PR_MENTOR_STORAGE=mongodb.
MONGODB_URI=mongodb://localhost:27017/pr_mentor?directConnection=true
MONGODB_DATABASE=pr_mentor

# Used when PR_MENTOR_STORAGE=sqlite.
PR_MENTOR_DATABASE_PATH=./data/pr_mentor.sqlite3

# Comma-separated browser origins allowed to call this API.
PR_MENTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://18rajritik.github.io,https://pr-mentor.github.io
PR_MENTOR_HTTP_TIMEOUT=15

# Firebase Admin identity verification. Supply inline JSON OR a mounted file,
# or use the deployment platform's Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Supabase Auth token verification for GitHub OAuth sessions.
SUPABASE_URL=https://your-project-ref.supabase.co

# Set one project key: SUPABASE_PUBLISHABLE_KEY (recommended), SUPABASE_PUBLIC_KEY, or legacy SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Optional exact callback URLs for GitHub OAuth through Supabase, including the
# trailing slash. If unset, the API accepts the browser URL only for an origin
# listed in PR_MENTOR_CORS_ORIGINS. Configure each URL in Supabase Redirect URLs.
PR_MENTOR_GITHUB_RETURN_URL=http://localhost:5173/

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same secret across API instances and restarts.
PR_MENTOR_GITHUB_TOKEN_KEY=

# Use the same credentials configured for Supabase's GitHub provider. These
# let PR Mentor revoke the stored OAuth token on GitHub during disconnect.
PR_MENTOR_GITHUB_CLIENT_ID=
PR_MENTOR_GITHUB_CLIENT_SECRET=
PR_MENTOR_GITHUB_TOKEN_KEY=
# Use the same credentials configured for Supabase's GitHub provider. These
# let PR Mentor revoke the stored OAuth token on GitHub during disconnect.
PR_MENTOR_GITHUB_CLIENT_ID=
PR_MENTOR_GITHUB_CLIENT_SECRET=
