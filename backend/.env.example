# Optional GitHub Personal Access Token to raise GitHub API rate limits.
GITHUB_TOKEN=

# Optional OpenAI-compatible provider. Without both values AI is reported unavailable.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Optional task-specific provider routing. Configure only the task/provider
# pairs you use. Each named provider needs an API key; endpoints must use HTTPS
# (localhost is allowed for development). Task model overrides take precedence
# over the provider's shared LLM_<NAME>_MODEL value.
#
# Example: use separate models for review, fixes, and teaching explanations.
# LLM_PROVIDER_CODE_REVIEW=reviewer
# LLM_MODEL_CODE_REVIEW_REVIEWER=review-model
# LLM_PROVIDER_FIX_GENERATION=coder
# LLM_MODEL_FIX_GENERATION_CODER=code-model
# LLM_PROVIDER_ISSUE_EXPLANATION=teacher
# LLM_MODEL_ISSUE_EXPLANATION_TEACHER=explanation-model
#
# Optional per-task fallback chains (ordered comma-separated provider names).
# LLM_FALLBACK_PROVIDERS_CODE_REVIEW=backup
# LLM_FALLBACK_PROVIDERS_FIX_GENERATION=backup
# LLM_FALLBACK_PROVIDERS_ISSUE_EXPLANATION=backup
#
# Named provider credentials/endpoints. Keep real credentials out of this file.
# LLM_REVIEWER_API_KEY=
# LLM_REVIEWER_API_BASE_URL=https://provider.example/v1/chat/completions
# LLM_CODER_API_KEY=
# LLM_CODER_API_BASE_URL=https://provider.example/v1/chat/completions
# LLM_TEACHER_API_KEY=
# LLM_TEACHER_API_BASE_URL=https://provider.example/v1/chat/completions
# LLM_BACKUP_API_KEY=
# LLM_BACKUP_API_BASE_URL=https://provider.example/v1/chat/completions
# LLM_BACKUP_MODEL=fallback-model
# LLM_PROVIDER_RETRIES=1
# LLM_BACKUP_MAX_CONCURRENCY=4

# Select sqlite (default) or mongodb. MongoDB failures never fall back to SQLite.
PR_MENTOR_STORAGE=sqlite

# Required when PR_MENTOR_STORAGE=mongodb.
MONGODB_URI=mongodb://localhost:27017/pr_mentor?directConnection=true
MONGODB_DATABASE=pr_mentor

# Used when PR_MENTOR_STORAGE=sqlite.
PR_MENTOR_DATABASE_PATH=./data/pr_mentor.sqlite3

# Comma-separated browser origins allowed to call this API.
PR_MENTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://18rajritik.github.io,https://pr-mentor.github.io
PR_MENTOR_HTTP_TIMEOUT=15

# Firebase Admin identity verification. Supply inline JSON OR a mounted file,
# or use the deployment platform's Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Supabase Auth token verification for GitHub OAuth sessions.
SUPABASE_URL=https://your-project-ref.supabase.co

# Set one project key: SUPABASE_PUBLISHABLE_KEY (recommended), SUPABASE_PUBLIC_KEY, or legacy SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
